NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Service role key: used ONLY by the server-side email delivery worker (bypasses RLS). Never expose to clients.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

AWS_REGION=us-east-1
AWS_S3_BUCKET=your-hipaa-notes-bucket
AWS_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/your-key-id

PAUBOX_API_KEY=your-paubox-api-key
PAUBOX_API_ENDPOINT=your-paubox-endpoint-username
PAUBOX_FROM_EMAIL=notes@yourclinic.example

NOTE_RETENTION_YEARS=10

# Seconds a presigned S3 PDF download URL stays valid (60..604800).
PDF_DOWNLOAD_URL_TTL_SECONDS=3600

# Async email delivery queue (background worker). Disabled by default; the email
# endpoint sends synchronously when disabled.
EMAIL_QUEUE_ENABLED=false
EMAIL_QUEUE_POLL_INTERVAL_MS=15000
EMAIL_QUEUE_BATCH_SIZE=10
EMAIL_QUEUE_MAX_ATTEMPTS=5
EMAIL_QUEUE_BACKOFF_BASE_SECONDS=60
